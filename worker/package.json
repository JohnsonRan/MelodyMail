{
  "name": "@melodymail/worker",
  "private": true,
  "type": "module",
  "dependencies": {
    "@mmmike/web-push": "1.5.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.18",
    "postal-mime": "^4.2.1",
    "resend": "6.38.1",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "scripts": {
    "typecheck": "bun --bun tsc -p . && bun --bun tsc -p test",
    "test": "bun --bun vitest run",
    "dev": "wrangler dev",
    "deploy": "bun run --cwd ../web build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply melodymail --local",
    "db:migrate:remote": "wrangler d1 migrations apply melodymail --remote",
    "prod-config": "bun scripts/prod-config.ts",
    "migrate:prod": "bun scripts/prod-config.ts && wrangler d1 migrations apply melodymail --remote --config .wrangler-production.jsonc",
    "deploy:prod": "bun scripts/prod-config.ts && bun run --cwd ../web build && wrangler deploy --config .wrangler-production.jsonc",
    "backup-restore": "bun scripts/backup-restore.ts",
    "bench:auth": "bun bench/auth.ts",
    "bench:backup": "bun bench/backup.ts",
    "bench:parse": "bun bench/parse.ts",
    "bench:rules": "bun bench/rules.ts",
    "bench:telegram": "bun bench/telegram.ts",
    "vapid": "bun scripts/vapid.ts",
    "upload-key": "bun scripts/upload-key.ts",
    "wrangler": "wrangler"
  }
}
