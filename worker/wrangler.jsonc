{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "melodymail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The SPA build from web/ is served from the same origin. /api/* always reaches the Worker
  // so that API routes never fall through to index.html.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
