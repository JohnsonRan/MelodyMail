{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "melodymail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The SPA build from web/ is served from the same origin. /api/* always reaches the Worker
  // so that API routes never fall through to index.html.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: wrangler provisions the database on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "melodymail", "migrations_dir": "migrations" }
  ],
  // DNS-over-HTTPS JSON endpoint for the domain DNS check (Settings > Domains). Resend: the API
  // origin and the plan's quota, shown beside the counts Resend reports (docs/M5-sending.md).
  "vars": {
    "DOH_URL": "https://cloudflare-dns.com/dns-query",
    "RESEND_API_URL": "https://api.resend.com",
    "RESEND_DAILY_LIMIT": "100",
    "RESEND_MONTHLY_LIMIT": "3000"
  },
  // Raw inbound mail (raw/{yyyy}/{mm}/{id}.eml). wrangler deploy creates the bucket when it is
  // missing (automatic provisioning, wrangler 4.45 and later).
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "melodymail-mail" }],
  // Inbound parse jobs carry only { id }. wrangler 4.162 creates a missing queue on deploy
  // (https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  // lists Queues); README has the manual create command.
  // max_batch_size 1: each parse may take up to the 3 ms Bun budget, about 3 times that on a
  // slower production CPU, and a consumer invocation has 10 ms CPU on Workers Free. No dead-letter
  // queue: the cron step re-enqueues every message still "stored" after 15 minutes.
  "queues": {
    "producers": [{ "binding": "INBOUND", "queue": "melodymail-inbound" }],
    "consumers": [{ "queue": "melodymail-inbound", "max_batch_size": 1, "max_retries": 5 }]
  },
  // Real-time push to open mailbox pages. Workers Free allows only SQLite-backed Durable Objects.
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // One trigger (Workers Free allows 5 per account): re-enqueue stuck messages, remove stale
  // uploads and old webhook events. M7 adds the R2 orphan sweep and trash clean-up here.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Abuse guard only: counts are approximate and per location. The strict recovery lockout is
  // counted in D1 (login_attempts). namespace_id is chosen here, not issued by an account.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // POST /api/push/test, per session.
    { "name": "PUSH_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
