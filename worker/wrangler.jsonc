{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "melodymail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The SPA build from web/ is served from the same origin. /api/* always reaches the Worker
  // so that API routes never fall through to index.html.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: wrangler provisions the database on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "melodymail", "migrations_dir": "migrations" }
  ],
  // Abuse guard only: counts are approximate and per location. The strict recovery lockout is
  // counted in D1 (login_attempts). namespace_id is chosen here, not issued by an account.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
