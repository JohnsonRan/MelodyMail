{
  "name": "melodymail",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "worker",
    "web"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.7"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:scripts && bun run check:i18n && bun run build && bun run check:requirements",
    "lint": "bun --bun biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter @melodymail/web build",
    "check:requirements": "uv run --no-project --python 3.13 scripts/check-requirements.py",
    "test:requirements": "uv run --no-project --python 3.13 scripts/test_check_requirements.py",
    "test:scripts": "bun test scripts",
    "check:i18n": "bun scripts/check-i18n.ts",
    "dev": "bun run --filter '*' dev",
    "deploy": "bun run --filter @melodymail/worker deploy"
  }
}
