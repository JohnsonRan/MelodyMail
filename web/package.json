{
  "name": "@melodymail/web",
  "private": true,
  "type": "module",
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@fontsource/figtree": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-router": "^1.170.46",
    "dompurify": "^3.4.18",
    "i18next": "^27.1.2",
    "marked": "18.2.0",
    "postal-mime": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "uqr": "^0.1.3",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "typecheck": "bun --bun tsc -p . && bun --bun tsc -p tsconfig.sw.json && bun --bun tsc -p test",
    "build": "bun --bun vite build",
    "astryx": "bun --bun node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "icons": "bun --bun pwa-assets-generator",
    "test:browser": "bun --bun vite build && bun test --timeout 20000 --path-ignore-patterns='**/pwa.test.ts' --path-ignore-patterns='**/compose.test.ts' --path-ignore-patterns='**/markdown.test.ts' ./test",
    "test:pwa": "bun --bun vite build && bun test --timeout 20000 ./test/pwa.test.ts",
    "test:send": "bun --bun vite build && bun test --timeout 20000 ./test/compose.test.ts ./test/markdown.test.ts"
  }
}
